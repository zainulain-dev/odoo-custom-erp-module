<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form View Inheritance -->
    <record id="view_partner_form_inherit_custom_erp" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.custom.erp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CRM Tracking" name="crm_tracking">
                    <group>
                        <group string="Tracking Information">
                            <field name="x_crm_tracking_id"/>
                            <field name="x_is_vip_client"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Partner List/Tree View Inheritance -->
    <record id="view_partner_tree_inherit_custom_erp" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.custom.erp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="x_crm_tracking_id" optional="show"/>
                <field name="x_is_vip_client" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
